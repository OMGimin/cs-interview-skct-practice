{
  "name": "cs-interview-skct-practice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:runtime": "npm run build && tsx scripts/runtime-smoke.ts",
    "check": "npm run typecheck && npm test && npm run content:check",
    "content:check": "tsx scripts/content.ts check",
    "content:sql": "tsx scripts/content.ts sql",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "npm run content:sql && wrangler d1 execute DB --local --file=content/seed.sql",
    "build": "wrangler deploy --dry-run --outdir=dist"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "@types/node": "^22.0.0",
    "miniflare": "5.20260923.0-alpha",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.40.0"
  }
}
